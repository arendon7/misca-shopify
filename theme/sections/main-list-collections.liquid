<section class="section">
  <div class="page-width">
    <header class="section-heading">
      <div><p class="eyebrow">Colecciones</p><h1>{{ section.settings.heading }}</h1></div>
      <div class="section-intro rte">{{ section.settings.text }}</div>
    </header>
    <div class="list-grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <a class="collection-tile" href="{{ collection.url }}">
            <div class="collection-tile__media">
              {% if collection.featured_image %}
                {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              {% elsif collection.products.first.featured_image %}
                {{ collection.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              {% else %}<div class="media-placeholder"></div>{% endif %}
            </div>
            <div class="collection-tile__body"><p class="eyebrow">Colección</p><h3>{{ collection.title }}</h3><p>{{ collection.products_count }} productos</p></div>
          </a>
        {% endunless %}
      {% else %}
        <p class="empty-state">Las colecciones aparecerán aquí cuando estén publicadas.</p>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Lista de colecciones","settings":[{"type":"text","id":"heading","label":"Título","default":"Colecciones"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Universos creativos organizados como colecciones pequeñas.</p>"}]}
{% endschema %}
