<section class="section"><div class="page-width section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><div><div class="section-intro rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></div></section>
{% schema %}{"name":"CTA creadores","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Para creadores"},{"type":"text","id":"heading","label":"Título","default":"Tú creas. Nosotros construimos el sistema alrededor."},{"type":"richtext","id":"text","label":"Texto","default":"<p>Producto, producción, ecommerce, pagos, logística, atención y liquidación.</p>"},{"type":"text","id":"button_label","label":"CTA","default":"Cómo funciona"},{"type":"url","id":"button_link","label":"Link"}],"presets":[{"name":"CTA creadores"}]}{% endschema %}
