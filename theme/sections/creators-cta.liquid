{% liquid
  assign creators_page = pages['creadores']
  if creators_page == blank
    assign creators_page = pages['para-creadores']
  endif
  assign cta_link = section.settings.button_link
  if cta_link == blank and creators_page != blank
    assign cta_link = creators_page.url
  endif
%}
<section class="section">
  <div class="page-width section-heading">
    <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <div><div class="section-intro rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank and cta_link != blank %}<a class="button" href="{{ cta_link }}">{{ section.settings.button_label }}</a>{% endif %}</div>
  </div>
</section>
{% schema %}
{
  "name":"CTA creadores",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Para creadores"},
    {"type":"text","id":"heading","label":"Título","default":"Tu obra. Una colección. Nuestra operación."},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>Tú defines la obra y movilizas tu comunidad. MISCA desarrolla el producto y se ocupa de tienda, cobro, producción, empaque, envío, soporte y liquidación.</p>"},
    {"type":"text","id":"button_label","label":"CTA","default":"Ver cómo funciona"},
    {"type":"url","id":"button_link","label":"Link"}
  ],
  "presets":[{"name":"CTA creadores"}]
}
{% endschema %}
