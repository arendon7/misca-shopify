<section class="section" data-misca-view-event="source_artwork_viewed" data-handle="{{ metaobject.system.handle | escape }}" data-title="{{ metaobject.title.value | escape }}"><div class="page-width prose-grid"><div><p class="eyebrow">Archivo Abierto · obra fuente</p><h1>{{ metaobject.title.value }}</h1><p class="lede">{{ metaobject.creator.value }} · {{ metaobject.date_text.value }}</p></div><div>{% if metaobject.source_image.value %}{{ metaobject.source_image.value | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high' }}{% endif %}<dl class="provenance-list"><div><dt>Institución</dt><dd>{{ metaobject.institution.value }}</dd></div><div><dt>Objeto</dt><dd>{{ metaobject.object_number.value }}</dd></div><div><dt>Derechos</dt><dd>{{ metaobject.rights_status.value }}</dd></div></dl><div class="rte">{{ metaobject.adaptation_notes.value | metafield_tag }}</div>{% if metaobject.source_url.value %}<a class="button button--secondary" href="{{ metaobject.source_url.value }}" target="_blank" rel="noopener">Fuente institucional</a>{% endif %}</div></div></section>
{% schema %}{"name":"Obra fuente","settings":[]}{% endschema %}
