<section class="home-hero"><div class="home-hero__copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h1>{{ section.settings.heading }}</h1><div class="lede rte">{{ section.settings.text }}</div><div class="button-row">{% if section.settings.primary_label != blank and section.settings.primary_link != blank %}<a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}{% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}</div></div><div class="home-hero__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}{% else %}<div class="media-placeholder media-placeholder--hero"></div>{% endif %}</div></section>
{% schema %}{"name":"Hero comercial","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Arte · prenda · historia"},{"type":"inline_richtext","id":"heading","label":"Título","default":"Arte que puedes llevar."},{"type":"richtext","id":"text","label":"Texto","default":"<p>Prendas construidas alrededor de artistas, obras e historias. Colecciones pequeñas, producción local y una manera diferente de descubrir lo que llevas puesto.</p>"},{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"primary_label","label":"CTA principal","default":"Descubrir colecciones"},{"type":"url","id":"primary_link","label":"Link principal"},{"type":"text","id":"secondary_label","label":"CTA secundario","default":"Conocer a los artistas"},{"type":"url","id":"secondary_link","label":"Link secundario"}],"presets":[{"name":"Hero comercial"}]}{% endschema %}
