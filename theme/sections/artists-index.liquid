<section class="section"><div class="page-width"><header class="section-heading"><div><p class="eyebrow">Artistas</p><h1>{{ page.title | default: section.settings.heading }}</h1></div><div class="section-intro rte">{{ section.settings.text }}</div></header><div class="list-grid">{% assign artist_entries = metaobjects.artist.values %}{% for artist in artist_entries %}<a class="artist-tile" href="{{ artist.system.url }}"><div class="artist-tile__media">{% if artist.hero_image.value %}{{ artist.hero_image.value | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}<div class="media-placeholder"></div>{% endif %}</div><div class="artist-tile__body"><p class="eyebrow">{{ artist.type.value }}</p><h3>{{ artist.name.value }}</h3><p>{{ artist.discipline.value }}</p></div></a>{% else %}<p class="empty-state">Los artistas activos aparecerán aquí.</p>{% endfor %}</div></div></section>
{% schema %}{"name":"Índice de artistas","settings":[{"type":"text","id":"heading","label":"Título fallback","default":"Artistas"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Personas, universos creativos y archivos históricos alrededor de los que construimos prendas.</p>"}]}{% endschema %}
