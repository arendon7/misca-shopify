<section class="metaobject-hero" data-misca-view-event="artist_viewed" data-handle="{{ metaobject.system.handle | escape }}" data-title="{{ metaobject.name.value | escape }}"><div class="metaobject-hero__copy"><p class="eyebrow">{{ metaobject.type.value }}</p><h1>{{ metaobject.name.value }}</h1><div class="lede">{{ metaobject.discipline.value }}</div>{% if metaobject.transparency_note.value != blank %}<p class="truth-notice">{{ metaobject.transparency_note.value }}</p>{% endif %}</div><div class="metaobject-hero__media">{% if metaobject.hero_image.value %}{{ metaobject.hero_image.value | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high' }}{% else %}<div class="media-placeholder media-placeholder--hero"></div>{% endif %}</div></section><section class="section"><div class="page-width prose-grid"><div><p class="eyebrow">Historia</p><h2>{{ metaobject.tagline.value }}</h2></div><div class="rte">{{ metaobject.story.value | metafield_tag }}</div></div></section>{% assign artist_collection = metaobject.primary_collection.value %}{% if artist_collection != blank %}<section class="section"><div class="page-width"><header class="section-heading"><div><p class="eyebrow">Colección</p><h2>{{ artist_collection.title }}</h2></div></header><div class="product-grid">{% for card_product in artist_collection.products limit: 8 %}{% render 'product-card', product: card_product %}{% endfor %}</div></div></section>{% endif %}
{% schema %}{"name":"Artista","settings":[]}{% endschema %}
