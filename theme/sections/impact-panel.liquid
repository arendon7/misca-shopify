{% assign impact = product.metafields.custom.impact_program.value %}{% if impact != blank %}<section class="section impact-panel" data-misca-view-event="impact_viewed" data-handle="{{ impact.system.handle | escape }}" data-title="{{ impact.name.value | escape }}" data-product-handle="{{ product.handle | escape }}"><div class="page-width prose-grid"><div><p class="eyebrow">El arte sigue dando</p><h2>{{ impact.name.value }}</h2></div><div><p class="impact-rate">{{ impact.rate_percent.value }}%</p><div class="rte">{{ impact.public_explanation.value | metafield_tag }}</div>{% if impact.status.value != 'active' %}<p class="truth-notice">Programa aún no publicado como activo.</p>{% endif %}</div></div></section>{% endif %}
{% schema %}{"name":"Impacto","settings":[],"presets":[{"name":"Impacto"}]}{% endschema %}
