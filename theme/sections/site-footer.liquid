<footer class="site-footer">
  <div class="page-width footer-grid">
    <div>
      <div class="wordmark">{{ settings.brand_wordmark | default: shop.name }}</div>
      <p class="muted">{{ section.settings.summary }}</p>
    </div>
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <p class="eyebrow">{{ block.settings.heading }}</p>
        {% if block.settings.menu != blank %}
          <ul class="footer-menu">
            {% for link in block.settings.menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</footer>
{% schema %}
{
  "name":"Footer",
  "settings":[
    {"type":"textarea","id":"summary","label":"Resumen","default":"Arte que puedes llevar. Colecciones pequeñas construidas alrededor de artistas, obras e historias."}
  ],
  "blocks":[
    {
      "type":"menu",
      "name":"Menú",
      "settings":[
        {"type":"text","id":"heading","label":"Título","default":"Explorar"},
        {"type":"link_list","id":"menu","label":"Menú"}
      ]
    }
  ],
  "max_blocks":4
}
{% endschema %}
