<s-view-event view-event-payload='{{ collection | standard_event_data: "view" | escape }}'>
<section class="section collection-page">
  <div class="page-width">
    <header class="collection-header">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="lede rte">{{ collection.description }}</div>{% endif %}
    </header>

    <div class="collection-hero-media">
      {% if collection.featured_image %}
        {{ collection.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800', sizes: '100vw', alt: collection.title }}
      {% elsif collection.products.first.featured_image %}
        {{ collection.products.first.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800', sizes: '100vw', alt: collection.title }}
      {% else %}
        {% render 'misca-universe-fallback', handle: collection.handle, alt: collection.title, loading: 'eager' %}
      {% endif %}
    </div>

    <div class="collection-toolbar">
      <span>{{ collection.products_count }} productos</span>
      <form>
        <label for="SortBy-{{ section.id }}">Ordenar</label>
        {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
        <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
      </form>
    </div>

    {% if collection.filters.size > 0 %}
      <details class="collection-filters">
        <summary>
          Filtrar
          {% assign active_filter_count = 0 %}
          {% for filter in collection.filters %}
            {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
          {% endfor %}
          {% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}
        </summary>

        <form class="filter-form">
          {% for filter in collection.filters %}
            <fieldset class="filter-group">
              <legend>{{ filter.label }}</legend>

              {% case filter.type %}
                {% when 'boolean' %}
                  {% if filter.true_value %}
                    <label>
                      <input
                        type="checkbox"
                        name="{{ filter.true_value.param_name }}"
                        value="{{ filter.true_value.value }}"
                        {% if filter.true_value.active %}checked{% endif %}
                        {% if filter.true_value.count == 0 and filter.true_value.active == false %}disabled{% endif %}
                      >
                      {{ filter.true_value.label }} ({{ filter.true_value.count }})
                    </label>
                  {% endif %}

                {% when 'list' %}
                  {% for filter_value in filter.values %}
                    <label>
                      <input
                        type="checkbox"
                        name="{{ filter_value.param_name }}"
                        value="{{ filter_value.value }}"
                        {% if filter_value.active %}checked{% endif %}
                        {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                      >
                      {{ filter_value.label }} ({{ filter_value.count }})
                    </label>
                  {% endfor %}

                {% when 'price_range' %}
                  <div class="price-filter">
                    <label>
                      Desde
                      <input
                        name="{{ filter.min_value.param_name }}"
                        type="number"
                        min="0"
                        max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        {% if filter.min_value.value %}
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                        {% endif %}
                      >
                    </label>
                    <label>
                      Hasta
                      <input
                        name="{{ filter.max_value.param_name }}"
                        type="number"
                        min="0"
                        max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        {% if filter.max_value.value %}
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                        {% endif %}
                      >
                    </label>
                  </div>
              {% endcase %}
            </fieldset>
          {% endfor %}

          <input type="hidden" name="sort_by" value="{{ sort_by }}">
          <div class="filter-actions">
            <button class="button" type="submit">Aplicar filtros</button>
            <a class="text-link" href="{{ collection.url }}?sort_by={{ sort_by }}">Limpiar</a>
          </div>
        </form>
      </details>

      <div class="active-filters">
        {% for filter in collection.filters %}
          {% for filter_value in filter.active_values %}
            <a href="{{ filter_value.url_to_remove }}">{{ filter.label }}: {{ filter_value.label }} ×</a>
          {% endfor %}
        {% endfor %}
      </div>
    {% endif %}

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="product-grid">
        {% for card_product in collection.products %}
          {% render 'product-card', product: card_product %}
        {% else %}
          <p class="empty-state">No encontramos productos con estos filtros.</p>
        {% endfor %}
      </div>
      {{ paginate | default_pagination }}
    {% endpaginate %}
  </div>
</section>
</s-view-event>
{% schema %}
{
  "name":"Colección principal",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Tienda"},
    {"type":"range","id":"products_per_page","label":"Productos por página","min":8,"max":40,"step":4,"default":20}
  ]
}
{% endschema %}
