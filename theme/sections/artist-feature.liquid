{% assign artist = section.settings.artist %}
<section class="split-feature"><div class="split-feature__media">{% if artist != blank and artist.hero_image.value %}{{ artist.hero_image.value | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '750, 1100, 1600', sizes: '(min-width: 990px) 50vw, 100vw' }}{% elsif section.settings.fallback_image %}{{ section.settings.fallback_image | image_url: width: 1600 | image_tag: loading: 'lazy' }}{% else %}<div class="media-placeholder media-placeholder--feature"></div>{% endif %}</div><div class="split-feature__copy split-feature__copy--dark"><p class="eyebrow">{% if artist != blank %}{{ artist.type.value }}{% else %}{{ section.settings.fallback_eyebrow }}{% endif %}</p><h2>{% if artist != blank %}{{ artist.tagline.value }}{% else %}{{ section.settings.fallback_heading }}{% endif %}</h2><div class="rte">{% if artist != blank %}{{ artist.story.value | metafield_tag }}{% else %}{{ section.settings.fallback_text }}{% endif %}</div>{% if artist != blank and artist.system.url %}<a class="button button--light-outline" href="{{ artist.system.url }}">Explorar artista</a>{% endif %}</div></section>
{% schema %}{"name":"Artista destacado","settings":[{"type":"metaobject","id":"artist","label":"Artista","metaobject_type":"artist"},{"type":"image_picker","id":"fallback_image","label":"Imagen fallback"},{"type":"text","id":"fallback_eyebrow","label":"Eyebrow fallback","default":"Artista"},{"type":"text","id":"fallback_heading","label":"Título fallback","default":"Una historia convertida en prenda."},{"type":"richtext","id":"fallback_text","label":"Texto fallback","default":"<p>Cada colección parte de una voz, una obra o un universo creativo y se desarrolla como producto, no como simple mercancía impresa.</p>"}],"presets":[{"name":"Artista destacado"}]}{% endschema %}
