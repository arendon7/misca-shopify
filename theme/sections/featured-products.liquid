{% assign featured_products = section.settings.products %}{% if featured_products.count > 0 or request.design_mode %}<section class="section"><div class="page-width"><header class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.text != blank %}<div class="section-intro rte">{{ section.settings.text }}</div>{% endif %}</header><div class="product-grid">{% for card_product in featured_products %}{% render 'product-card', product: card_product %}{% else %}{% if request.design_mode %}{% for i in (1..2) %}<article class="product-card" aria-hidden="true"><div class="product-card__media"><div class="media-placeholder"></div></div><div class="product-card__meta"><p class="eyebrow">Editor del tema</p><h3>Selecciona un producto</h3></div></article>{% endfor %}{% endif %}{% endfor %}</div></div></section>{% endif %}
{% schema %}{"name":"Productos destacados","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Comprar ahora"},{"type":"text","id":"heading","label":"Título","default":"Dos maneras de entrar."},{"type":"richtext","id":"text","label":"Texto","default":"<p>Producto primero; historia después.</p>"},{"type":"product_list","id":"products","label":"Productos","limit":8}],"presets":[{"name":"Productos destacados"}]}{% endschema %}
