<section class="section">
  <div class="page-width">
    <p class="eyebrow">Buscar</p>
    <h1>{{ section.settings.heading }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Prendas, artistas, colecciones…"
        aria-label="Buscar"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button" type="submit">Buscar</button>
    </form>

    {% if search.performed %}
      <p>{{ search.results_count }} resultados para “{{ search.terms | escape }}”</p>

      {% paginate search.results by section.settings.results_per_page %}
        <div class="search-results">
          {% for item in search.results %}
            {% case item.object_type %}
              {% when 'product' %}
                {% render 'product-card', product: item %}
              {% else %}
                <article class="article-card">
                  <div class="article-card__body">
                    <p class="eyebrow">{{ item.object_type }}</p>
                    <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  </div>
                </article>
            {% endcase %}
          {% else %}
            <p class="empty-state">No encontramos resultados. Prueba con otro término o explora las colecciones.</p>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="pagination" aria-label="Resultados de búsqueda">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Búsqueda",
  "settings":[
    {"type":"text","id":"heading","label":"Título","default":"Buscar en MISCA"},
    {"type":"range","id":"results_per_page","label":"Resultados por página","min":8,"max":40,"step":4,"default":20}
  ]
}
{% endschema %}
