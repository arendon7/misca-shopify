<article class="section"><div class="page-width article-prose"><p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p><h1>{{ article.title }}</h1>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high' }}{% endif %}<div class="rte">{{ article.content }}</div><p><a class="text-link" href="{{ blog.url }}">← Volver a {{ blog.title }}</a></p></div></article><script type="application/ld+json">{{ article | structured_data }}</script>
{% schema %}{"name":"Artículo","settings":[]}{% endschema %}
