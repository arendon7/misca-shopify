{% assign artwork = section.settings.artwork %}
<section class="section"><div class="page-width editorial-grid"><div class="editorial-card"><div class="archive-feature__media">{% if artwork != blank and artwork.source_image.value %}{{ artwork.source_image.value | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: artwork.title.value }}{% else %}<img src="{{ 'misca-universe-hokusai.svg' | asset_url }}" alt="Estudio editorial conceptual de La fuerza del agua · Hokusai" loading="lazy">{% endif %}</div><p class="eyebrow">Archivo Abierto</p>{% if artwork != blank %}<h2>{{ artwork.title.value }}</h2><p>{{ artwork.creator.value }} · {{ artwork.date_text.value }}</p><div class="rte">{{ artwork.adaptation_notes.value | metafield_tag }}</div>{% if artwork.system.url %}<a class="button button--secondary" href="{{ artwork.system.url }}">Ver procedencia</a>{% endif %}{% else %}<h2>Obras que vuelven a circular.</h2><p>Archivo Abierto reúne obras históricas con procedencia y derechos documentados para estudiar cómo pueden convertirse en prendas sin borrar su origen.</p><span class="visual-provenance-note">Imagen de contexto conceptual. La obra fuente y su procedencia se mantienen separadas.</span>{% endif %}</div><div class="editorial-card editorial-card--dark"><p class="eyebrow">El arte sigue dando</p><h3>{{ section.settings.impact_heading }}</h3><p class="muted-light">{{ section.settings.impact_text }}</p></div></div></section>
{% schema %}{"name":"Archivo Abierto","settings":[{"type":"metaobject","id":"artwork","label":"Obra fuente","metaobject_type":"artwork_source"},{"type":"text","id":"impact_heading","label":"Título impacto","default":"La circulación de una obra también puede dejar algo después."},{"type":"textarea","id":"impact_text","label":"Texto impacto","default":"Los detalles públicos del programa solo deben mostrarse cuando el beneficiario y la mecánica estén formalmente cerrados."}],"presets":[{"name":"Archivo Abierto"}]}{% endschema %}
