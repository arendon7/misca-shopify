<section class="creators-hero section">
  <div class="page-width">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <div class="lede rte">{{ section.settings.text }}</div>
    <div class="steps-grid">
      {% for block in section.blocks %}
        <article class="step-card" {{ block.shopify_attributes }}>
          <span class="step-card__number">0{{ forloop.index }}</span>
          <h2>{{ block.settings.heading }}</h2>
          <div class="rte">{{ block.settings.text }}</div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Para creadores",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Para creadores"},
    {"type":"text","id":"heading","label":"Título","default":"Tu obra. Una colección. Todo lo demás resuelto."},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>El creador diseña y promociona; la plataforma desarrolla producto, produce, cobra, empaca, envía, atiende y liquida.</p>"}
  ],
  "blocks":[
    {
      "type":"step",
      "name":"Paso",
      "settings":[
        {"type":"text","id":"heading","label":"Título","default":"Curamos."},
        {"type":"richtext","id":"text","label":"Texto","default":"<p>Seleccionamos artistas y obras con potencial real de producto.</p>"}
      ]
    }
  ],
  "presets":[{"name":"Para creadores","blocks":[{"type":"step"},{"type":"step"},{"type":"step"}]}]
}
{% endschema %}
