{% assign artwork = product.metafields.custom.artwork.value %}{% if artwork != blank %}<section class="section provenance-section" data-misca-view-event="source_artwork_viewed" data-artwork-handle="{{ artwork.system.handle | escape }}" data-title="{{ artwork.title.value | escape }}" data-product-handle="{{ product.handle | escape }}"><div class="page-width prose-grid"><div><p class="eyebrow">Archivo Abierto · procedencia</p><h2>{{ artwork.title.value }}</h2></div><div><dl class="provenance-list"><div><dt>Autor</dt><dd>{{ artwork.creator.value }}</dd></div><div><dt>Fecha</dt><dd>{{ artwork.date_text.value }}</dd></div><div><dt>Institución</dt><dd>{{ artwork.institution.value }}</dd></div><div><dt>Objeto</dt><dd>{{ artwork.object_number.value }}</dd></div><div><dt>Derechos</dt><dd>{{ artwork.rights_status.value }}</dd></div></dl>{% if artwork.adaptation_notes.value != blank %}<div class="rte">{{ artwork.adaptation_notes.value | metafield_tag }}</div>{% endif %}{% if artwork.source_url.value != blank %}<a class="text-link" href="{{ artwork.source_url.value }}" rel="noopener" target="_blank">Fuente institucional</a>{% endif %}</div></div></section>{% endif %}
{% schema %}{"name":"Procedencia de obra","settings":[],"presets":[{"name":"Procedencia de obra"}]}{% endschema %}
