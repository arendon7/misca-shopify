<section class="section"><div class="page-width"><header class="section-heading"><div><p class="eyebrow">Historias</p><h1>{{ blog.title }}</h1></div><div class="section-intro rte">{{ section.settings.intro }}</div></header>
{% paginate blog.articles by section.settings.articles_per_page %}<div class="blog-grid">{% for article in blog.articles %}<article class="article-card">{% if article.image %}<a class="article-card__media" href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}</a>{% endif %}<div class="article-card__body"><p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p></div></article>{% else %}<p class="empty-state">Las historias aparecerán aquí.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</div></section>
{% schema %}{"name":"Blog","settings":[{"type":"richtext","id":"intro","label":"Introducción","default":"<p>Procesos, artistas, obras y decisiones detrás de cada colección.</p>"},{"type":"range","id":"articles_per_page","label":"Artículos por página","min":3,"max":24,"step":3,"default":9}]}{% endschema %}
