{% liquid
  assign card_product = product
  assign artist = card_product.metafields.custom.artist.value
  assign secondary_image = card_product.images[1]
  assign commerce_status = card_product.metafields.custom.commerce_status.value | default: 'draft'
  assign commerce_ready = true
  assign concept_primary = ''
  assign concept_secondary = ''
  assign concept_primary_width = 1200
  assign concept_primary_height = 1500

  if settings.enforce_commerce_readiness
    unless commerce_status == 'ready'
      assign commerce_ready = false
    endunless
  endif

  case card_product.handle
    when 'raiz-de-concreto'
      assign concept_primary = 'misca-v37-raiz-campaign.webp'
      assign concept_secondary = 'misca-raiz-context.svg'
      assign concept_primary_width = 888
      assign concept_primary_height = 740
    when 'ola-hokusai'
      assign concept_primary = 'misca-v37-ola-editorial.webp'
      assign concept_secondary = 'misca-ola-context.svg'
      assign concept_primary_width = 908
      assign concept_primary_height = 808
  endcase
%}
<article class="product-card" data-analytics-product-card data-product-handle="{{ card_product.handle | escape }}" data-product-title="{{ card_product.title | escape }}" data-artist-handle="{% if artist != blank %}{{ artist.system.handle | escape }}{% endif %}" data-collection-handle="{% if collection %}{{ collection.handle | escape }}{% endif %}" data-commerce-status="{{ commerce_status | escape }}" data-surface="{{ request.page_type | escape }}">
  <a href="{{ card_product.url }}" class="product-card__link">
    <div class="product-card__media">
      {% if card_product.featured_image %}
        {{ card_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 25vw, 50vw', alt: card_product.featured_image.alt | default: card_product.title, class: 'product-card__image product-card__image--primary' }}
        {% if secondary_image %}{{ secondary_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 25vw, 50vw', alt: secondary_image.alt | default: card_product.title, class: 'product-card__image product-card__image--secondary' }}{% endif %}
      {% elsif concept_primary != blank %}
        <img class="product-card__image product-card__image--primary" src="{{ concept_primary | asset_url }}" width="{{ concept_primary_width }}" height="{{ concept_primary_height }}" alt="Visual conceptual de {{ card_product.title | escape }}" loading="lazy">
        <img class="product-card__image product-card__image--secondary" src="{{ concept_secondary | asset_url }}" width="1200" height="900" alt="Contexto conceptual de {{ card_product.title | escape }}" loading="lazy">
        <span class="misca-concept-badge">Visual conceptual</span>
      {% else %}
        <div class="media-placeholder" aria-hidden="true"></div>
      {% endif %}
      {% if commerce_ready == false %}
        <span class="product-card__badge">{% if commerce_status == 'validation' %}En validación{% else %}Próximamente{% endif %}</span>
      {% elsif card_product.available == false %}
        <span class="product-card__badge">Agotado</span>
      {% elsif card_product.metafields.custom.artwork.value != blank %}
        <span class="product-card__badge">Archivo Abierto</span>
      {% endif %}
    </div>
    <div class="product-card__meta">
      <p class="eyebrow">{% if artist != blank %}{{ artist.name.value | default: artist.system.handle }}{% else %}{{ card_product.vendor }}{% endif %}</p>
      <div class="product-card__row">
        <h3>{{ card_product.title }}</h3>
        <span>{% if commerce_ready or settings.show_prelaunch_price %}{{ card_product.price | money }}{% else %}Precio por confirmar{% endif %}</span>
      </div>
      {% unless commerce_ready %}<span class="product-card__commerce">Compra todavía no habilitada</span>{% endunless %}
    </div>
  </a>
</article>
