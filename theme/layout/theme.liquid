<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-page-type="{{ request.page_type | escape }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink | default: '#151515' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{%- if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif -%}{%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}{%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% if request.page_type == 'search' or request.page_type == '404' %}<meta name="robots" content="noindex,follow">{% endif %}
    {% render 'meta-tags' %}
    {{ content_for_header }}
    {% style %}:root{--bg: {{ settings.color_bg | default: '#F5F2EA' }};--surface: {{ settings.color_surface | default: '#FFFDF8' }};--ink: {{ settings.color_ink | default: '#151515' }};--muted: {{ settings.color_muted | default: '#6D6A64' }};}{% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script type="module" src="{{ 'storefront-events.js' | asset_url }}"></script>
    <script src="{{ 'analytics.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
  </body>
</html>
